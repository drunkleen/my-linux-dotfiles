#compdef open opendir vc cat vim lz ls l ll ld lt mkdir install remove remove_deps search list info aur_install aur_remove aur_remove_deps aur_search aur_list aur_info docker dockerstart dockerstop dockerlist pgstart pgstop mongostart mongostop searxstart searxstop redisstart redisstop initmvn initgo send-notif iporigin ips shellhelp

local -a pacman_pkgs installed_pkgs aur_installed_pkgs iface_names

_shell_shortcuts_pkg_available() {
  pacman_pkgs=(${(f)"$(pacman -Slq 2>/dev/null | sort -u)"})
  (( ${#pacman_pkgs[@]} )) && _describe 'packages' pacman_pkgs
}

_shell_shortcuts_pkg_installed() {
  installed_pkgs=(${(f)"$(pacman -Qq 2>/dev/null | sort -u)"})
  (( ${#installed_pkgs[@]} )) && _describe 'installed packages' installed_pkgs
}

_shell_shortcuts_pkg_aur_installed() {
  aur_installed_pkgs=(${(f)"$(pacman -Qmq 2>/dev/null | sort -u)"})
  (( ${#aur_installed_pkgs[@]} )) && _describe 'installed AUR packages' aur_installed_pkgs
}

_shell_shortcuts_iface_names() {
  iface_names=(${(f)"$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}')"})
  (( ${#iface_names[@]} )) && _describe 'interfaces' iface_names
}

case "$service" in
  open|opendir|vc|cat|vim|lz|ls|l|ll|ld|lt)
    _files
    ;;
  mkdir)
    _directories
    ;;
  install|info)
    _shell_shortcuts_pkg_available || _message 'package'
    ;;
  remove|remove_deps)
    _shell_shortcuts_pkg_installed || _message 'installed package'
    ;;
  search|aur_search)
    _message 'query'
    ;;
  list|update|aur_list|dockerstart|dockerstop|dockerlist|pgstart|pgstop|mongostart|mongostop|searxstart|searxstop|redisstart|redisstop|ips|shellhelp)
    _nothing
    ;;
  aur_install|aur_info)
    _message 'AUR package'
    ;;
  aur_remove|aur_remove_deps)
    _shell_shortcuts_pkg_aur_installed || _message 'installed AUR package'
    ;;
  initmvn|initgo)
    _message 'project name'
    ;;
  send-notif)
    _message 'message'
    ;;
  iporigin)
    _hosts
    ;;
  docker)
    _docker
    ;;
  *)
    _default
    ;;
esac
