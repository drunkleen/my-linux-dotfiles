#compdef ntool

local -a level1
level1=(
  'status:Show plain status output'
  'summary:Show plain status output'
  'watch:Refresh plain status output on an interval'
  'json:Show JSON snapshot'
  'vpn:WireGuard profile myvpn'
  'lan:WireGuard profile mylan'
  'ssh:OpenSSH service'
  'ts:Tailscale client'
  'tsd:Tailscale daemon'
  'ifaces:List interfaces'
  'ips:List interface addresses'
  'ip:Show one interface'
  'devices:List devices in a table'
  'public-ip:Show public IPv4'
  'public-ip6:Show public IPv6'
  'routes:List routes'
  'gateway:Show default gateway'
  'dns:List DNS servers'
  'ports:Show listening ports'
  'ping:Ping a host'
  'resolve:Resolve a host'
  'checks:Run connectivity checks'
  'internet:Run connectivity checks'
  'help:Show usage'
)

local -a vpn_cmds ssh_cmds ts_cmds tsd_cmds
vpn_cmds=('on:Activate' 'off:Deactivate' 'status:Status')
ssh_cmds=('on:Start' 'off:Stop' 'restart:Restart' 'status:Status' 'enable:Enable at boot' 'disable:Disable at boot' 'port:Show SSH port')
ts_cmds=('on:Activate' 'off:Deactivate' 'status:Status' 'ip:Show Tailscale IP' 'peers:Show peers')
tsd_cmds=('on:Start daemon' 'off:Stop daemon' 'enable:Enable daemon at boot' 'disable:Disable daemon at boot')
local -a iface_names
iface_names=(${(f)"$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}')"})

if (( CURRENT == 2 )); then
  _describe 'ntool commands' level1
  return
fi

case "$words[2]" in
  watch)
    _numbers
    ;;
  ip)
    _describe 'interfaces' iface_names
    ;;
  ping|resolve)
    _hosts
    ;;
  vpn|lan)
    (( CURRENT == 3 )) && _describe 'actions' vpn_cmds
    ;;
  ssh)
    (( CURRENT == 3 )) && _describe 'actions' ssh_cmds
    ;;
  ts)
    (( CURRENT == 3 )) && _describe 'actions' ts_cmds
    ;;
  tsd)
    (( CURRENT == 3 )) && _describe 'actions' tsd_cmds
    ;;
esac
