typeset -gU fpath
fpath=("$HOME/.config/shell/completions" $fpath)

[[ -f "$HOME/.config/shell/theme.zsh" ]] && source "$HOME/.config/shell/theme.zsh"

autoload -Uz compinit
if [[ -z "${_SHELL_COMPINIT_DONE:-}" ]]; then
  compinit
  _SHELL_COMPINIT_DONE=1
fi

for _shell_file in "$HOME"/.config/shell/aliases.d/*.zsh(N); do
  source "$_shell_file"
done

for _shell_file in "$HOME"/.config/shell/functions.d/*.zsh(N); do
  source "$_shell_file"
done

autoload -Uz _shell_shortcuts _ntool
compdef _shell_shortcuts \
  open opendir vc cat vim lz ls l ll ld lt mkdir update \
  pkg aur \
  docker dockerstart dockerstop dockerlist \
  postgres mongo redis searx \
  initmvn initgo send-notif iporigin ips shellhelp
compdef _ntool ntool

unset _shell_file
