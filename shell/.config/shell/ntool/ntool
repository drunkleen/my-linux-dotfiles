#!/usr/bin/env bash

set -euo pipefail

if [[ -n "${_NTOOL_ROOT:-}" ]]; then
    return 0 2>/dev/null || exit 0
fi

if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    _ntool_source_file="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
    _ntool_source_file="${(%):-%N}"
else
    _ntool_source_file="$0"
fi

_NTOOL_ROOT="$(CDPATH= cd -- "$(dirname -- "${_ntool_source_file}")" && pwd)"
unset _ntool_source_file

for _ntool_module in core output network services commands; do
    # Source in a fixed order because later modules depend on earlier helpers.
    # shellcheck source=/dev/null
    . "${_NTOOL_ROOT}/lib/${_ntool_module}.sh"
done

unset _ntool_module

if [[ "${BASH_SOURCE[0]:-}" == "$0" ]]; then
    ntool_main "$@"
fi
